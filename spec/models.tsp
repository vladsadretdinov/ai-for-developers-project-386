import "@typespec/http";

using Http;

namespace BookingCalendar;

// ---------------------------------------------------------------------------
// Доменные сущности
// ---------------------------------------------------------------------------

/**
 * Владелец календаря.
 *
 * Единственный заранее заданный профиль. Регистрации нет — этот профиль
 * по умолчанию используется в админской части. Гость владельца не создаёт
 * и не редактирует, поэтому наружу доступен только для чтения.
 */
@doc("Владелец календаря — единственный предзаданный профиль.")
model Owner {
  @doc("Идентификатор владельца.")
  @visibility(Lifecycle.Read)
  id: string;

  @doc("Отображаемое имя владельца.")
  name: string;

  @doc("Контактный email владельца.")
  email: string;

  @doc("Таймзона владельца в формате IANA, например \"Europe/Moscow\".")
  timeZone: string;
}

/**
 * Тип события (вид брони).
 *
 * Владелец задаёт набор типов событий. Каждый тип описывает, на какую
 * встречу можно записаться: её название, описание и длительность в минутах.
 */
@doc("Тип события, на который можно записаться.")
model EventType {
  @doc("Идентификатор типа события.")
  @visibility(Lifecycle.Read)
  id: string;

  @doc("Название типа события, например \"Демо продукта\".")
  @minLength(1)
  @maxLength(120)
  title: string;

  @doc("Описание типа события для гостя.")
  @maxLength(2000)
  description: string;

  @doc("Длительность встречи в минутах.")
  @minValue(1)
  @maxValue(1440)
  durationMinutes: int32;
}

/** Тело запроса на создание типа события (поля, задаваемые владельцем). */
@doc("Данные для создания типа события.")
model EventTypeCreate {
  @doc("Название типа события.")
  @minLength(1)
  @maxLength(120)
  title: string;

  @doc("Описание типа события.")
  @maxLength(2000)
  description: string;

  @doc("Длительность встречи в минутах.")
  @minValue(1)
  @maxValue(1440)
  durationMinutes: int32;
}

/**
 * Слот — свободный интервал времени, на который можно записаться.
 *
 * Слоты не хранятся отдельно как записи владельца: они вычисляются на лету
 * для конкретного типа события на ближайшие 14 дней. Слот считается занятым,
 * если на его время уже есть бронирование (любого типа события).
 */
@doc("Свободный слот для записи на конкретный тип события.")
model Slot {
  @doc("Начало слота (UTC, ISO 8601).")
  start: utcDateTime;

  @doc("Конец слота (UTC, ISO 8601). Равен start + durationMinutes типа события.")
  end: utcDateTime;
}

/** Статус бронирования. */
@doc("Статус бронирования.")
enum BookingStatus {
  @doc("Активное бронирование.")
  confirmed,

  @doc("Бронирование отменено.")
  cancelled,
}

/**
 * Бронирование — запись гостя на конкретный слот конкретного типа события.
 *
 * Хранит выбранный интервал времени и контакты гостя. Анонимность гостя
 * сохраняется: аккаунт не создаётся, гость идентифицируется только данными,
 * указанными при бронировании.
 */
@doc("Бронирование слота гостем.")
model Booking {
  @doc("Идентификатор бронирования.")
  @visibility(Lifecycle.Read)
  id: string;

  @doc("Идентификатор типа события, на который сделана запись.")
  eventTypeId: string;

  @doc("Начало встречи (UTC, ISO 8601).")
  start: utcDateTime;

  @doc("Конец встречи (UTC, ISO 8601).")
  @visibility(Lifecycle.Read)
  end: utcDateTime;

  @doc("Имя гостя.")
  @minLength(1)
  @maxLength(120)
  guestName: string;

  @doc("Email гостя.")
  guestEmail: string;

  @doc("Необязательный комментарий гостя к встрече.")
  @maxLength(2000)
  notes?: string;

  @doc("Статус бронирования.")
  @visibility(Lifecycle.Read)
  status: BookingStatus;

  @doc("Момент создания бронирования (UTC, ISO 8601).")
  @visibility(Lifecycle.Read)
  createdAt: utcDateTime;
}

/**
 * Тело запроса на создание бронирования.
 *
 * Гость указывает тип события, желаемое время начала (из свободных слотов окна)
 * и свои контакты. Время окончания вычисляется сервером по длительности типа.
 */
@doc("Данные для создания бронирования гостем.")
model BookingCreate {
  @doc("Идентификатор типа события.")
  eventTypeId: string;

  @doc("Начало выбранного слота (UTC, ISO 8601).")
  start: utcDateTime;

  @doc("Имя гостя.")
  @minLength(1)
  @maxLength(120)
  guestName: string;

  @doc("Email гостя.")
  guestEmail: string;

  @doc("Необязательный комментарий гостя.")
  @maxLength(2000)
  notes?: string;
}

// ---------------------------------------------------------------------------
// Вспомогательные модели ответов и ошибок
// ---------------------------------------------------------------------------

/** Список свободных слотов для типа события в заданном окне. */
@doc("Свободные слоты типа события в окне записи.")
model SlotList {
  @doc("Идентификатор типа события.")
  eventTypeId: string;

  @doc("Начало окна доступности (UTC, ISO 8601).")
  windowStart: utcDateTime;

  @doc("Конец окна доступности (UTC, ISO 8601). По умолчанию windowStart + 14 дней.")
  windowEnd: utcDateTime;

  @doc("Список свободных слотов внутри окна.")
  slots: Slot[];
}

/** Стандартное тело ошибки. */
@error
@doc("Описание ошибки.")
model ApiError {
  @doc("Машиночитаемый код ошибки.")
  code: string;

  @doc("Человекочитаемое сообщение.")
  message: string;
}

/** Ошибка валидации входных данных. */
@error
@doc("Некорректные входные данные.")
model ValidationError {
  @statusCode statusCode: 422;
  code: "validation_failed";
  message: string;

  @doc("Список полей с ошибками.")
  fields?: string[];
}

/** Ресурс не найден. */
@error
@doc("Запрашиваемый ресурс не найден.")
model NotFoundError {
  @statusCode statusCode: 404;
  code: "not_found";
  message: string;
}

/**
 * Конфликт занятости.
 *
 * Возникает при попытке создать бронирование на время, которое уже занято
 * другим бронированием (в т.ч. другого типа события).
 */
@error
@doc("Время уже занято другим бронированием.")
model SlotTakenError {
  @statusCode statusCode: 409;
  code: "slot_taken";
  message: string;
}
