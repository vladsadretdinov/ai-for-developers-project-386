import "@typespec/http";
import "@typespec/rest";
import "@typespec/openapi";

import "./models.tsp";
import "./owner.tsp";
import "./guest.tsp";

using Http;
using Rest;
using OpenAPI;

/**
 * Сервис бронирования слотов в стиле Calendly.
 *
 * В системе нет регистрации и авторизации.
 * Есть две роли:
 *  - Владелец календаря — единственный заранее заданный профиль.
 *    Работает в админской части: управляет типами событий и видит все бронирования.
 *  - Гость — анонимный посетитель. Без аккаунта смотрит типы событий,
 *    открывает календарь свободных слотов на ближайшие 14 дней и создаёт бронирование.
 *
 * Главное инвариантное правило: на одно и то же время не может существовать
 * двух бронирований, даже если они относятся к разным типам событий.
 */
@service(#{ title: "Booking Calendar API" })
@info(#{ version: "1.0.0" })
@server("http://localhost:3000", "Локальный сервер разработки")
namespace BookingCalendar;
